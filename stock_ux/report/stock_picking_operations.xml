<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_ux" inherit_id="stock.report_picking">
        <xpath expr="//span[@t-field='move.product_id.display_name']" position="before">
            <span t-if="env['ir.config_parameter'].sudo().get_param('stock_ux.delivery_slip_use_origin', 'False') == 'True' and move.origin_description" t-field="move.origin_description"/><br t-if="env['ir.config_parameter'].sudo().get_param('stock_ux.delivery_slip_use_origin', 'False') == 'True' and move.origin_description"/>
        </xpath>
        <xpath expr="//span[@t-field='move.product_id.display_name']" position="attributes">
            <attribute name="t-if">env['ir.config_parameter'].sudo().get_param('stock_ux.delivery_slip_use_origin', 'False') != 'True' or not move.origin_description</attribute>
        </xpath>
    </template>
</odoo>
